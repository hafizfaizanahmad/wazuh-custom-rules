<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
<rule id="100102" level="12">
    <if_sid>500</if_sid>
    <match>powershell</match>
    <description>Custom: Suspicious PowerShell Execution Detected (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100103" level="10">
    <if_sid>500</if_sid>
    <match>rm -rf /var/log/</match>
    <description>Custom: Attempt to Delete System Logs (T1070)</description>
    <mitre>
      <id>T1070</id>
    </mitre>
  </rule>

  <rule id="100104" level="8">
    <if_sid>500</if_sid>
    <match>/etc/cron</match>
    <description>Custom: Persistence Added via Cron Job Modification (T1053.003)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
  </rule>

  <rule id="100105" level="12">
    <if_sid>500</if_sid>
    <match>cat /etc/shadow</match>
    <description>Custom: Unauthorized Access to Sensitive Shadow File (T1003.008)</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
  </rule>
</group>
