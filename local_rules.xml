<!-- Rule 1: SSH/PAM failed login from an external IP (tuned: lab host excluded) -->
<group name="local,syslog,sshd,">
  <rule id="100201" level="10">
    <if_sid>5503</if_sid>
    <srcip negate="yes">192.168.88.1</srcip>
    <description>Custom: Failed SSH/PAM login from external IP (T1110.001)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,custom_rule,</group>
  </rule>
</group>

<!-- Rule 5: Root shell opened via sudo -->
<group name="local,syslog,sudo,">
  <rule id="100205" level="10">
    <if_sid>5402,5403</if_sid>
    <match>COMMAND=/bin/bash</match>
    <description>Custom: Root shell opened via sudo (T1548.003)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>privilege_escalation,custom_rule,</group>
  </rule>
</group>

<!-- Rules 2-4: PowerShell, log deletion, cron persistence -->
<group name="local,syslog,">
  <rule id="100102" level="12">
    <if_sid>500</if_sid>
    <match>powershell</match>
    <description>Custom: Suspicious PowerShell Execution Detected (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100103" level="10">
    <if_sid>500</if_sid>
    <match>rm -rf /var/log/</match>
    <description>Custom: Attempt to Delete System Logs (T1070)</description>
    <mitre>
      <id>T1070</id>
    </mitre>
  </rule>

  <rule id="100104" level="8">
    <if_sid>500</if_sid>
    <match>/etc/cron</match>
    <description>Custom: Persistence Added via Cron Job Modification (T1053.003)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
  </rule>
</group>
